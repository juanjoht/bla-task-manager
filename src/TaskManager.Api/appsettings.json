{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Data Source=taskmanager.db"
  },
  "Jwt": {
    "Issuer": "TaskManager",
    "Audience": "TaskManager.Client",
    "ExpirationMinutes": 60
  },
  "App": {
    "TimeZone": "America/Bogota"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  }
}
